---
/**
 * CaseStudy layout — the shared shell for every case study.
 *
 * Renders the frontmatter (title, kind, summary, stack, links) as a
 * consistent header, then slots the Markdown body below in .prose styling.
 * A confidentiality notice appears automatically when `confidential: true`.
 */
import Base from './Base.astro';
import Tag from '../components/Tag.astro';

interface Props {
  title: string;
  kind: 'industry' | 'research' | 'experiment';
  summary: string;
  stack: string[];
  links: { label: string; url: string }[];
  confidential: boolean;
}

const { title, kind, summary, stack, links, confidential } = Astro.props;

// Human-readable label for the kind, shown as the kicker.
const kindLabel = {
  industry: 'Industry · Production AI',
  research: 'Research · Shipped',
  experiment: 'Self-directed research',
}[kind];
---

<Base title={title} description={summary}>
  <article class="container case-study">
    <!-- Header: kicker, title, summary, stack, links -->
    <header class="cs-header">
      <p class="section-kicker" data-reveal>{kindLabel}</p>
      <h1 class="cs-title" data-reveal data-reveal-delay="1">{title}</h1>
      <p class="cs-summary" data-reveal data-reveal-delay="2">{summary}</p>

      <div class="cluster" data-reveal data-reveal-delay="3">
        {stack.map((tech) => <Tag label={tech} />)}
      </div>

      {links.length > 0 && (
        <ul class="cs-links" data-reveal data-reveal-delay="4">
          {links.map((link) => (
            <li><a class="link-draw" href={link.url}>{link.label} ↗</a></li>
          ))}
        </ul>
      )}

      {confidential && (
        <p class="cs-confidential" data-reveal data-reveal-delay="4">
          This case study is kept at a safe level of abstraction — no client
          names or internal architecture — because it describes production
          enterprise software.
        </p>
      )}
    </header>

    <!-- Body: the Markdown content, styled by .prose -->
    <div class="prose cs-body" data-reveal>
      <slot />
    </div>

    <!-- Back link -->
    <p class="cs-back">
      <a class="link-draw" href="/work/">← All work</a>
    </p>
  </article>
</Base>

<style>
  .case-study {
    padding-block: var(--space-16);
  }

  .cs-header {
    max-width: var(--measure);
    display: grid;
    gap: var(--space-4);
    padding-bottom: var(--space-8);
    border-bottom: 1px solid var(--color-border);
  }

  .cs-title {
    font-size: var(--text-3xl);
  }

  .cs-summary {
    font-size: var(--text-md);
    color: var(--color-ink-muted);
    line-height: 1.6;
  }

  .cs-links {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-6);
    font-size: var(--text-sm);
    font-weight: 500;
  }

  .cs-confidential {
    font-size: var(--text-sm);
    color: var(--color-ink-muted);
    border-left: 2px solid var(--color-accent);
    padding-left: var(--space-4);
    font-style: italic;
  }

  .cs-body {
    margin-top: var(--space-12);
  }

  .cs-back {
    margin-top: var(--space-16);
    font-size: var(--text-sm);
  }
</style>
