---
/**
 * Base layout — the HTML shell every page is built inside.
 *
 * It provides:
 *   - the <head> with SEO metadata (title, description, canonical, Open Graph)
 *   - the global stylesheets (tokens + base)
 *   - the skip link, top navigation, and footer
 *   - a <main> landmark that page content is slotted into
 *
 * Every page passes at least a `title` and `description` so each page has
 * unique, meaningful metadata (strategy §T — SEO).
 */
// Self-hosted variable fonts (Fontsource). Importing the package registers
// the @font-face rules; tokens in typography.css map them to our variables.
import '@fontsource-variable/newsreader';
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '@fontsource/caveat';

import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/typography.css';
import '../styles/layout.css';
import '../styles/motion.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
// ClientRouter enables Astro view transitions: internal navigations swap the
// page content with a fast cross-fade + slight rise (motion moment #5,
// strategy §G) instead of a full browser reload. Browsers without support
// fall back to normal navigation automatically.
import { ClientRouter } from 'astro:transitions';
import { ANALYTICS, LINKEDIN_URL, GITHUB_URL } from '../site.config';

interface Props {
  title: string;        // becomes "<title> — Jahanzeb Naeem" in the browser tab
  description: string;  // used for the meta description and social previews
}

const { title, description } = Astro.props;

// The canonical URL of the current page, e.g. https://jnx01.github.io/research/
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
// Absolute URL of the social preview image.
const ogImage = new URL('/images/og.jpg', Astro.site);

// JSON-LD Person schema (strategy §T) — helps search engines understand who
// this site is about. Only real, verifiable facts.
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Jahanzeb Naeem',
  url: Astro.site,
  image: ogImage.toString(),
  jobTitle: 'AI Engineer',
  worksFor: { '@type': 'Organization', name: 'Teradata' },
  address: { '@type': 'PostalAddress', addressLocality: 'Islamabad', addressCountry: 'PK' },
  sameAs: [LINKEDIN_URL, GITHUB_URL],
};

---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Mark that JS is available BEFORE first paint. Motion.css only hides
         reveal elements when this class exists, so no-JS users always see
         the full page. Placed first in <head> to avoid a flash. -->
    <script is:inline>
      document.documentElement.classList.add('js');

      // Tab visibility: mark <html> with .is-visible once the tab is actually
      // being viewed. Time-based CSS animations (the hero wash, the underline
      // draw) start paused and only play when this class is present, so
      // opening the page in a background tab doesn't spend them unseen.
      function markVisible() {
        if (document.visibilityState === 'visible') {
          document.documentElement.classList.add('is-visible');
        }
      }
      markVisible(); // in case the tab is already visible at load
      document.addEventListener('visibilitychange', markVisible);

      // Theme (light/dark): apply the saved choice, or the OS preference,
      // BEFORE first paint so there is no flash of the wrong theme.
      // The toggle button lives in Nav.astro; it writes localStorage.theme.
      function getTheme() {
        const saved = localStorage.getItem('theme');
        if (saved === 'light' || saved === 'dark') return saved;
        return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      }
      function applyTheme(theme) {
        document.documentElement.dataset.theme = theme;
        // Keep the browser chrome color in sync with the page background.
        const meta = document.querySelector('meta[name="theme-color"]');
        if (meta) meta.setAttribute('content', theme === 'dark' ? '#161614' : '#fafaf8');
      }
      applyTheme(getTheme());

      // View transitions swap in the NEW page's <html> element, which has
      // neither the "js" class nor the theme (both are only set by this
      // script). Put them back after every swap, or the "js" styles
      // (reveals, laptop layout) and the chosen theme would stop working
      // after the first client-side navigation.
      document.addEventListener('astro:after-swap', () => {
        document.documentElement.classList.add('js');
        applyTheme(getTheme());
        markVisible(); // the new <html> also needs the visibility mark
      });
    </script>

    <!-- Browser chrome color: matches the page background so the tab bar /
         mobile URL bar blends in. The inline script above keeps it in sync
         with the light/dark toggle. -->
    <meta name="theme-color" content="#fafaf8" />

    <!-- Primary SEO metadata -->
    <title>{title} · Jahanzeb Naeem</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph: controls how links to this site look when shared -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Jahanzeb Naeem" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />

    <!-- Structured data: Person schema for search engines -->
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <!-- Astro injects the sitemap link here automatically via the integration -->
    <link rel="sitemap" href="/sitemap-index.xml" />

    <ClientRouter />
  </head>
  <body>
    <!-- Keyboard users can jump straight past the nav to the content -->
    <a class="skip-link" href="#main">Skip to content</a>

    <Nav />

    <main id="main">
      <!-- The current page's content is inserted here -->
      <slot />
    </main>

    <Footer />

    <!-- Reveal-on-scroll: one IntersectionObserver watches every element
         marked [data-reveal] and adds .is-revealed the first time it enters
         the viewport. ~20 lines, no library, unobserve after reveal so
         nothing loops or re-triggers.

         It runs on first load AND after every view-transition page swap
         (astro:page-load), because client-side navigation replaces the DOM
         and the new page's [data-reveal] elements need fresh observers. -->
    <script is:inline>
      function setupReveals() {
        const els = document.querySelectorAll('[data-reveal]:not(.is-revealed)');
        // No IntersectionObserver (very old browser) -> show everything.
        if (!('IntersectionObserver' in window)) {
          els.forEach((el) => el.classList.add('is-revealed'));
          return;
        }
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-revealed');
                io.unobserve(entry.target); // reveal once, then stop watching
              }
            }
          },
          { rootMargin: '0px 0px -10% 0px' } // trigger slightly before fully in view
        );
        els.forEach((el) => io.observe(el));
      }
      // astro:page-load fires on initial load and after each client-side
      // navigation, so it covers both cases with one listener.
      document.addEventListener('astro:page-load', setupReveals);
    </script>

    <!-- Proof-strip count-up (modification strategy 03, moment A): when a
         number marked [data-count-to] is revealed, count it from 0 up to its
         real value over ~600ms, once. Evidence that feels counted, not
         claimed (strategy §E).

         The final value is always in the HTML, so no-JS and reduced-motion
         users simply see the number. The script only runs when reduced
         motion is NOT requested. -->
    <script is:inline>
      function setupCountUps() {
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

        const els = document.querySelectorAll('[data-count-to]:not([data-counted])');
        if (!els.length) return;

        // Start every counter at 0 NOW (while it may still be off-screen),
        // so the count is visible when it happens. Without this, an element
        // already in view at load would flash its final value and the count
        // would be invisible. The real value returns if JS never runs.
        els.forEach((el) => {
          el.textContent = '0' + (el.dataset.countSuffix || '');
        });

        const run = (el) => {
          el.dataset.counted = '1'; // never count twice
          const target = parseInt(el.dataset.countTo, 10);
          const suffix = el.dataset.countSuffix || '';
          const duration = 1400; // ms — slow enough to watch the number climb
          const start = performance.now();

          const tick = (now) => {
            const t = Math.min((now - start) / duration, 1);
            // Ease-out so the number settles rather than stops abruptly.
            const eased = 1 - Math.pow(1 - t, 3);
            el.textContent = Math.round(eased * target) + suffix;
            if (t < 1) requestAnimationFrame(tick);
          };
          requestAnimationFrame(tick);
        };

        // Count when the element's reveal fires (it gets .is-revealed), or
        // immediately if it's already revealed (e.g. above the fold).
        const io = new IntersectionObserver((entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              run(entry.target);
              io.unobserve(entry.target);
            }
          }
        }, { rootMargin: '0px 0px -10% 0px' });

        els.forEach((el) => io.observe(el));
      }
      document.addEventListener('astro:page-load', setupCountUps);
    </script>

    <!-- Hero portrait parallax (motion moment #1, strategy §E/§F): the
         portrait drifts a few percent slower than the text as you scroll,
         adding subtle depth. Transform-only (GPU-friendly), driven by
         requestAnimationFrame so it stays smooth.

         Disabled when the user prefers reduced motion, and on touch devices
         (coarse pointers) where scroll-linked movement tends to jank —
         strategy §S. The element is looked up fresh on each frame so the
         script keeps working after view-transition page swaps. -->
    <script is:inline>
      (() => {
        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const coarsePointer = window.matchMedia('(pointer: coarse)').matches;
        if (reduceMotion || coarsePointer) return;

        // How much slower the portrait moves vs. the page (0.06 = 6%).
        const STRENGTH = 0.06;
        let ticking = false;

        function update() {
          // Look up the portrait fresh each frame — it only exists on the
          // home page, and view transitions replace the DOM on navigation.
          const el = document.querySelector('[data-parallax]');
          if (el) {
            // Shift the portrait down slightly as the page scrolls up, so it
            // appears to lag behind the text.
            el.style.transform = `translateY(${window.scrollY * STRENGTH}px)`;
          }
          ticking = false;
        }

        window.addEventListener('scroll', () => {
          if (!ticking) {
            window.requestAnimationFrame(update);
            ticking = true;
          }
        }, { passive: true });
      })();
    </script>

    <!-- First-party visitor analytics (Cloudflare Worker + D1).
         Only loads when ANALYTICS.TELEMETRY_ENDPOINT is set in site.config.ts. -->
    {ANALYTICS.TELEMETRY_ENDPOINT && (
      <script is:inline define:vars={{ endpoint: ANALYTICS.TELEMETRY_ENDPOINT }}>
        (() => {
          if (!endpoint || window.__telemetryInit) return;
          window.__telemetryInit = true;

          // Generate a compact random ID
          const uid = () =>
            (crypto.randomUUID ? crypto.randomUUID() : Math.random().toString(36).slice(2) + Date.now().toString(36));

          // Persistent Visitor ID (localStorage) + per-tab Session ID (sessionStorage)
          let visitorId = null;
          let isNewVisitor = false;
          let sessionId = null;
          let isNewSession = false;

          try {
            visitorId = localStorage.getItem('_vid');
            if (!visitorId) {
              visitorId = uid();
              localStorage.setItem('_vid', visitorId);
              isNewVisitor = true;
            }
            sessionId = sessionStorage.getItem('_sid');
            if (!sessionId) {
              sessionId = uid();
              sessionStorage.setItem('_sid', sessionId);
              isNewSession = true;
            }
          } catch {
            visitorId = uid();
            sessionId = uid();
          }

          // Extract WebGL unmasked GPU renderer (e.g. "Apple M3 Max", "NVIDIA RTX 4090")
          function getGpuRenderer() {
            try {
              const canvas = document.createElement('canvas');
              const gl = canvas.getContext('webgl') || canvas.getContext('experimental-webgl');
              if (!gl) return null;
              const ext = gl.getExtension('WEBGL_debug_renderer_info');
              return ext ? gl.getParameter(ext.UNMASKED_RENDERER_WEBGL) : gl.getParameter(gl.RENDERER);
            } catch {
              return null;
            }
          }

          // Simple FNV-1a 32-bit hash for non-cookie hardware fingerprint matching
          function fnv1a(str) {
            let h = 0x811c9dc5;
            for (let i = 0; i < str.length; i++) {
              h ^= str.charCodeAt(i);
              h = Math.imul(h, 0x01000193);
            }
            return (h >>> 0).toString(16).padStart(8, '0');
          }

          const gpu = getGpuRenderer();
          const cores = navigator.hardwareConcurrency || null;
          const ram = navigator.deviceMemory || null;
          const screenInfo = `${screen.width}x${screen.height} @${window.devicePixelRatio || 1}x`;
          const tz = Intl.DateTimeFormat().resolvedOptions().timeZone || '';
          const lang = navigator.language || '';
          const connObj = navigator.connection || navigator.mozConnection || navigator.webkitConnection;
          const conn = connObj
            ? `${connObj.effectiveType || ''}${connObj.downlink ? ' (' + connObj.downlink + 'Mbps)' : ''}`.trim()
            : null;

          // Stable hardware signature so returning visitors can be linked even if storage is cleared
          const hwHash = fnv1a([gpu, cores, ram, screenInfo, tz, lang, navigator.platform].join('|'));

          // Per-page state (reset on every Astro View Transition)
          let viewId = null;
          let currentPath = '';
          let prevPath = '';
          let activeMs = 0;
          let lastTick = Date.now();
          let lastActivity = Date.now();
          let maxScrollPct = 0;
          let sectionsSeen = new Set();
          let pendingEvents = [];
          let sectionObserver = null;

          function computeScrollPct() {
            const doc = document.documentElement;
            const scrollable = doc.scrollHeight - window.innerHeight;
            if (scrollable <= 0) return 100;
            return Math.min(100, Math.max(0, Math.round((window.scrollY / scrollable) * 100)));
          }

          function sendBeaconPayload(payload) {
            const body = JSON.stringify(payload);
            if (navigator.sendBeacon) {
              try {
                // Use text/plain Blob so navigator.sendBeacon is a CORS-simple
                // request (no preflight OPTIONS needed and no credentials blockage).
                const blob = new Blob([body], { type: 'text/plain;charset=UTF-8' });
                if (navigator.sendBeacon(endpoint, blob)) return;
              } catch {}
            }
            fetch(endpoint, {
              method: 'POST',
              body,
              headers: { 'Content-Type': 'text/plain;charset=UTF-8' },
              credentials: 'omit',
              keepalive: true,
            }).catch(() => {});
          }

          function flushHeartbeat() {
            if (!viewId) return;
            const now = Date.now();
            if (document.visibilityState === 'visible' && now - lastActivity < 60000) {
              activeMs += now - lastTick;
            }
            lastTick = now;
            maxScrollPct = Math.max(maxScrollPct, computeScrollPct());

            const eventsToSend = pendingEvents.splice(0, pendingEvents.length);
            sendBeaconPayload({
              type: 'heartbeat',
              visitorId,
              sessionId,
              viewId,
              path: currentPath,
              activeSec: Math.round(activeMs / 1000),
              scrollPct: maxScrollPct,
              sections: Array.from(sectionsSeen),
              theme: document.documentElement.dataset.theme || 'light',
              events: eventsToSend,
            });
          }

          function recordEvent(type, target, meta) {
            pendingEvents.push({
              ts: new Date().toISOString(),
              path: currentPath,
              type,
              target,
              meta,
            });
            // Flush high-value events (like Resume or outbound clicks) right away
            if (type === 'resume' || type === 'outbound' || pendingEvents.length >= 5) {
              flushHeartbeat();
            }
          }

          function observePageSections() {
            if (sectionObserver) sectionObserver.disconnect();
            if (!('IntersectionObserver' in window)) return;
            const targets = document.querySelectorAll('main section[id], main section[aria-labelledby], main article');
            sectionObserver = new IntersectionObserver(
              (entries) => {
                for (const entry of entries) {
                  if (entry.isIntersecting) {
                    const label =
                      entry.target.id ||
                      entry.target.getAttribute('aria-labelledby') ||
                      entry.target.querySelector('h1, h2')?.textContent?.trim()?.slice(0, 40);
                    if (label) sectionsSeen.add(label);
                  }
                }
              },
              { threshold: 0.35 }
            );
            targets.forEach((el) => sectionObserver.observe(el));
          }

          function startPageView() {
            // Flush the previous page before starting the new one on client-side navigation
            if (viewId) flushHeartbeat();

            viewId = uid();
            prevPath = currentPath;
            currentPath = location.pathname;
            activeMs = 0;
            lastTick = Date.now();
            lastActivity = Date.now();
            maxScrollPct = computeScrollPct();
            sectionsSeen = new Set();

            const params = new URLSearchParams(location.search);
            sendBeaconPayload({
              type: 'pageview',
              visitorId,
              isNewVisitor,
              sessionId,
              isNewSession,
              viewId,
              hwHash,
              path: currentPath,
              title: document.title,
              referrer: prevPath || document.referrer || '',
              utmSource: params.get('utm_source') || params.get('ref') || params.get('source') || '',
              utmMedium: params.get('utm_medium') || '',
              utmCampaign: params.get('utm_campaign') || '',
              query: location.search,
              scrollPct: maxScrollPct,
              viewport: `${window.innerWidth}x${window.innerHeight}`,
              gpu,
              cores,
              ram,
              screen: screenInfo,
              lang,
              tz,
              conn,
              theme: document.documentElement.dataset.theme || 'light',
            });

            // Only the very first pageview of the session/visitor carries the "new" flags
            isNewVisitor = false;
            isNewSession = false;

            observePageSections();
          }

          // Track active reading time (ticks every 1s while tab is visible & user was active in last 60s)
          setInterval(() => {
            const now = Date.now();
            if (document.visibilityState === 'visible' && now - lastActivity < 60000) {
              activeMs += now - lastTick;
            }
            lastTick = now;
          }, 1000);

          // Periodic background sync every 15s while reading so data isn't lost if browser crashes
          setInterval(() => {
            if (document.visibilityState === 'visible' && Date.now() - lastActivity < 30000) {
              flushHeartbeat();
            }
          }, 15000);

          const markActive = () => {
            lastActivity = Date.now();
          };
          window.addEventListener('scroll', () => {
            markActive();
            maxScrollPct = Math.max(maxScrollPct, computeScrollPct());
          }, { passive: true });
          window.addEventListener('pointerdown', markActive, { passive: true });
          window.addEventListener('keydown', markActive, { passive: true });

          // Capture link clicks, resume opens, email button, and interactive widget controls
          document.addEventListener('click', (e) => {
            markActive();
            const link = e.target.closest('a[href]');
            if (link) {
              const href = link.getAttribute('href') || '';
              const text = (link.textContent || link.getAttribute('aria-label') || '').trim().slice(0, 60);
              if (href.includes('drive.google.com') || /resume/i.test(text)) {
                recordEvent('resume', text || 'Resume PDF', { href });
              } else if (/^https?:\/\//i.test(href) && !href.includes(location.hostname)) {
                recordEvent('outbound', text || href, { href });
              }
              return;
            }
            const btn = e.target.closest('button, [role="button"], input[type="radio"]');
            if (btn) {
              const label = (
                btn.getAttribute('aria-label') ||
                btn.textContent ||
                btn.name ||
                btn.id ||
                'button'
              ).trim().slice(0, 60);
              recordEvent('widget', label);
            }
          }, { capture: true });

          // Capture range slider interactions (e.g., BudgetSlider on /work/experiments)
          document.addEventListener('change', (e) => {
            if (e.target && e.target.matches('input[type="range"], input[type="radio"]')) {
              const label = e.target.name || e.target.id || e.target.getAttribute('aria-label') || 'control';
              recordEvent('widget', `${label}: ${e.target.value}`);
            }
          });

          // Capture text copy events (e.g., someone copying your email or citation)
          document.addEventListener('copy', () => {
            const sel = (window.getSelection()?.toString() || '').trim().slice(0, 80);
            if (sel) recordEvent('copy', sel);
          });

          // Flush when switching tabs or closing the page
          document.addEventListener('visibilitychange', () => {
            lastTick = Date.now();
            if (document.visibilityState === 'hidden') flushHeartbeat();
          });
          window.addEventListener('pagehide', flushHeartbeat);

          // Fire on initial load and after every Astro View Transition navigation
          document.addEventListener('astro:page-load', startPageView);
        })();
      </script>
    )}

    <!-- GoatCounter analytics (legacy, disabled by default in site.config.ts). -->
    {ANALYTICS.GOATCOUNTER_ENABLED && (
      <script
        is:inline
        async
        data-goatcounter={`https://${ANALYTICS.GOATCOUNTER_CODE}.goatcounter.com/count`}
        src="https://gc.zgo.at/count.js"
      ></script>
    )}
  </body>
</html>

<style>
  /* Page transition: fast cross-fade + slight rise (strategy §G, moment #5).
     Astro's default fade is close; we add the small upward settle on the
     incoming page. Kept quick (200ms) so navigation feels instant. */
  @media (prefers-reduced-motion: no-preference) {
    @keyframes page-rise {
      from {
        opacity: 0;
        transform: translateY(8px);
      }
      to {
        opacity: 1;
        transform: none;
      }
    }

    ::view-transition-old(root) {
      animation: 180ms var(--ease-out) both fade-out;
    }

    ::view-transition-new(root) {
      animation: 220ms var(--ease-out) both page-rise;
    }
  }

  /* Reduced motion: no view-transition animation at all — instant swap. */
  @media (prefers-reduced-motion: reduce) {
    ::view-transition-old(root),
    ::view-transition-new(root) {
      animation: none;
    }
  }
</style>
