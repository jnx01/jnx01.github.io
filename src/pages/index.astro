    <div class="container">
      <dl class="proof-strip">
        <!-- Count-up (modification strategy 03, moment A): each number counts
             from 0 to its value when scrolled into view — evidence that feels
             counted, not claimed (strategy §E). data-count-to is the target,
             data-count-suffix preserves the +/× suffixes. The full value is
             in the markup, so no-JS and reduced-motion users see it as-is. -->
        <div class="proof-item" data-reveal>
          <dt class="proof-label">Enterprise AI systems shipped</dt>
          <dd class="proof-value" data-count-to="3" data-count-suffix="+">3+</dd>
        </div>
        <div class="proof-item" data-reveal data-reveal-delay="1">
          <dt class="proof-label">AI agent APIs architected</dt>
          <dd class="proof-value" data-count-to="2">2</dd>
        </div>
        <div class="proof-item" data-reveal data-reveal-delay="2">
          <dt class="proof-label">Performance awards, 2 promotions</dt>
          <dd class="proof-value" data-count-to="4" data-count-suffix="×">4×</dd>
        </div>
        <div class="proof-item" data-reveal data-reveal-delay="3">
          <dt class="proof-label">Peer-reviewed AI paper</dt>
          <dd class="proof-value" data-count-to="1">1</dd>
