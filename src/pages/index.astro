---
/**
 * Home — the scroll narrative (strategy §D). Six movements:
 *   1. Hero            — editorial statement + headshot + contact actions
 *   2. Proof strip     — quantified facts, no adjectives
 *   3. Selected work   — three flagship case studies, weighted
 *   4. Research teaser — theme + two pillars, link to /research
 *   5. Experience      — one-line-per-role compressed timeline
 *   6. Person          — 2–3 sentences of humanity + the talk photo
 *
 * Every claim below is backed by the audit (planning/ARCHITECTURE.md) or the
 * resumes. Nothing here is invented.
 */
import Base from '../layouts/Base.astro';
import Headshot from '../components/Headshot.astro';
import AvatarIntro from '../components/AvatarIntro.astro';
import Card from '../components/Card.astro';
import Laptop from '../components/Laptop.astro';
import LaptopScreens from '../components/LaptopScreens.astro';
import { RESUME_URL, EMAIL_DISPLAY, LINKEDIN_URL, GITHUB_URL } from '../site.config';
---

<Base
  title="AI Engineer"
  description="Jahanzeb Naeem builds and evaluates AI systems that have to work outside the notebook: production GenAI at Teradata, and honest experiments on efficiency and reliability."
>
  <!-- THE JOURNEY LAPTOP (planning/ARCHITECTURE.md §10) -------------------------
       One fixed, click-through laptop that follows the scroll. It stays
       hidden (display: none) unless JS is on, motion is allowed and the
       screen is >= 1100px wide. The script in this file moves it; see
       "Journey laptop" below. It sits ABOVE the section backgrounds but
       BELOW the section content, so it can never cover text.
       The screen shows small still pictures of real work from this site
       (see LaptopScreens.astro); the script cross-fades them as you scroll. -->
  <!-- THE DASHED PATH (planning/ARCHITECTURE.md §10): the laptop's route down the
       page. The faint dashed line is the road ahead; the solid accent line
       is the trail the laptop has already travelled. The script draws it
       (page-sized, scrolls with the page) from the same maths that moves the
       laptop, so the laptop is always exactly on the line. -->
  <svg class="journey-path" data-journey-path aria-hidden="true" focusable="false">
    <path class="journey-path-ahead"></path>
    <path class="journey-path-trail" pathLength="1"></path>
  </svg>

  <div class="journey-laptop" data-journey-laptop aria-hidden="true">
    <Laptop>
      <LaptopScreens />
    </Laptop>
  </div>

  <!-- 1. HERO -------------------------------------------------------------
      Asymmetric editorial composition: statement left, portrait right
      (roughly a third of the width on desktop). The action row under the
      statement carries the primary CTA (resume) plus the three contact
      links, so a recruiter never has to scroll to act. -->
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-text">
        <h1 class="hero-statement">
          <span class="hero-line" data-reveal>I build and evaluate</span>
          <span class="hero-line" data-reveal data-reveal-delay="1">AI systems that have to work</span>
          <span class="hero-line" data-reveal data-reveal-delay="2">
            <span class="hero-underline">
              outside the notebook.<svg
                class="hero-underline-stroke"
                viewBox="0 0 300 12"
                preserveAspectRatio="none"
                aria-hidden="true"
                focusable="false"
              ><path d="M3 8 C 60 3, 150 10, 297 6" /></svg>
            </span>
          </span>
        </h1>
        <p class="hero-byline" data-reveal data-reveal-delay="1">
          Jahanzeb Naeem · AI Engineer · Teradata · Islamabad
        </p>
        <!-- One-line summary: same facts as the page description and the
             work cards (Teradata GenAI; self-directed efficiency and
             reliability studies). Nothing new is claimed. -->
        <p class="hero-summary" data-reveal data-reveal-delay="2">
          Production GenAI at Teradata. Research on cheaper, more reliable agents.
        </p>
        <!-- The action row: one primary button (the work index) + Email,
             LinkedIn, GitHub, Resume as quiet text links. "Email" matches the
             links visually, but instead of navigating it reveals the
             obfuscated address in a small popup. Works on hover (desktop),
             focus (keyboard), and click/tap (mobile). The address stays out
             of any href, so scrapers get nothing actionable. -->
        <div class="hero-cta" data-reveal data-reveal-delay="3">
          <a class="btn-primary" href="/work/">See My Work</a>
          <ul class="hero-links">
            <li class="email-reveal">
              <button
                type="button"
                class="link-draw email-reveal-btn"
                aria-describedby="email-tooltip"
              >
                Email
              </button>
              <span class="email-tooltip" id="email-tooltip" role="tooltip">
                {EMAIL_DISPLAY}
              </span>
            </li>
            <li><a class="link-draw" href={LINKEDIN_URL} rel="me">LinkedIn</a></li>
            <li><a class="link-draw" href={GITHUB_URL} rel="me">GitHub</a></li>
            <!-- Quiet resume link (Google Drive, read-only) for recruiters
                 who need a PDF. -->
            <li><a class="link-draw" href={RESUME_URL}>Resume</a></li>
          </ul>
        </div>
      </div>
      <div class="hero-portrait" data-reveal="fade" data-reveal-delay="2" data-parallax>
        <!-- Plain headshot with a thin-line border (the soft matte lives in
             Headshot.astro). The two-sided flip card was removed on
             2026-10-02 — see WORKING-NOTES.
             AvatarIntro wraps it: on the FIRST visit of a session a 3D
             avatar waves hello, then sinks away and this photo pops up.
             Everyone else (and reduced-motion users) just see the photo. -->
        <AvatarIntro>
          <Headshot />
        </AvatarIntro>
      </div>
    </div>
  </section>

  <!-- 2. PROOF STRIP -------------------------------------------------------
      Four quantified facts. Numbers, not adjectives. Each is verifiable
      against the resumes/audit. -->
