      <div data-reveal>
        <h2 class="section-title">Three things I've built, in depth.</h2>
      </div>

      <div class="grid">
        <!-- Card deal (modification strategy 03, moment C): the three
             flagships deal in weight order — Teradata first, then
             SignChatter, then Experiments — 120ms apart. -->
