---
/**
 * Top navigation — minimal by design (strategy §C).
 *
 * Five short text links plus the name as a wordmark that links home.
 * No hamburger menu on desktop; the items are short enough to fit even on
 * small phones (≥360px). The current page's link is marked with
 * aria-current="page" so screen readers announce it, and styled subtly.
 */

// The list of nav items. Adding a page to the nav means adding one line here.
const items = [
  { label: 'Work', href: '/work/' },
  { label: 'Research', href: '/research/' },
  { label: 'About', href: '/about/' },
  { label: 'Notes', href: '/notes/' },
  { label: 'Contact', href: '/contact/' },
];

// Figure out which nav item (if any) matches the page being viewed,
// so we can highlight it and mark it for screen readers.
const currentPath = Astro.url.pathname;
const isCurrent = (href: string) => currentPath.startsWith(href);
---

<header class="site-header">
  <nav class="container nav" aria-label="Main navigation">
    <!-- Wordmark: the name doubles as the "home" link -->
    <a href="/" class="wordmark">Jahanzeb Naeem</a>

    <ul class="nav-list">
      {items.map((item) => (
        <li>
          <a
            href={item.href}
            class:list={['nav-link', { current: isCurrent(item.href) }]}
            aria-current={isCurrent(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>

    <!-- Light/dark theme toggle. A simple light bulb: outline in light mode,
         lit (filled, with rays) in dark mode. The actual theme flip is done
         by the script below; the starting theme is applied in Base.astro
         before first paint, so this button only ever switches the choice. -->
    <button
      type="button"
      class="theme-toggle"
      data-theme-toggle
      aria-label="Switch to dark mode"
      aria-pressed="false"
    >
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
        <!-- Bulb glass -->
        <path
          class="bulb-glass"
          d="M12 3a6 6 0 0 0-3.6 10.8c.7.6 1.1 1.3 1.1 2.2h5c0-.9.4-1.6 1.1-2.2A6 6 0 0 0 12 3z"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linejoin="round"
        />
        <!-- Bulb base -->
        <path
          d="M9.5 18.5h5M10 21h4"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
        />
        <!-- Rays: only visible in dark mode (the bulb is "on") -->
        <g class="bulb-rays" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
          <path d="M12 0.8v1.4" />
          <path d="M4.2 4.4l1 1" />
          <path d="M19.8 4.4l-1 1" />
        </g>
      </svg>
    </button>
  </nav>
</header>

<style>
  .site-header {
    /* The nav stays visible while scrolling, on a slightly translucent
       background so content passing underneath stays readable. */
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--color-bg) 88%, transparent);
    -webkit-backdrop-filter: blur(12px); /* older Safari needs the prefix */
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--color-border);
  }

  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap; /* let the list drop below the wordmark if space runs out */
    gap: var(--space-2) var(--space-4);
    padding-block: var(--space-4);
  }

  .wordmark {
    font-family: var(--font-display);
    font-size: var(--text-md);
    font-weight: 600;
    color: var(--color-ink);
    letter-spacing: -0.01em;
  }

  .wordmark:hover {
    color: var(--color-ink);
    text-decoration: none;
  }

  .nav-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-6);
    list-style: none;
    padding: 0;
    /* With three children (wordmark, list, toggle), space-between would
       center the list. This pins the list to the right, next to the toggle. */
    margin-left: auto;
    margin-right: var(--space-4);
  }

  .nav-link {
    font-size: var(--text-sm);
    color: var(--color-ink-muted);
    /* Generous tap target on mobile (≥44px tall) without looking padded. */
    padding-block: var(--space-2);
  }

  .nav-link:hover {
    color: var(--color-ink);
    text-decoration: none;
  }

  /* The current page's link: ink color + a small accent underline. */
  .nav-link.current {
    color: var(--color-ink);
    box-shadow: inset 0 -2px 0 var(--color-accent);
  }

  /* On narrow phones, tighten gaps and shrink the wordmark so all five
     items fit without horizontal scrolling. */
  @media (max-width: 480px) {
    .wordmark {
      font-size: var(--text-base);
    }

    .nav-list {
      gap: var(--space-2) var(--space-4);
    }

    .nav-link {
      font-size: var(--text-xs);
    }
  }

  /* ---- Theme toggle ------------------------------------------------------
     A quiet icon button at the right end of the nav. Same ink color as the
     wordmark; the accent ring appears on keyboard focus via the global
     :focus-visible rule. */
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    /* 44px tap target on mobile without looking big (visual box is smaller). */
    min-width: 44px;
    min-height: 44px;
    margin-block: calc((44px - 28px) / -2); /* keep the nav height unchanged */
    background: none;
    border: none;
    padding: 0;
    color: var(--color-ink-muted);
    cursor: pointer;
    border-radius: var(--radius-sm);
    transition: color var(--duration-fast) var(--ease-out);
  }

  .theme-toggle:hover {
    color: var(--color-ink);
  }

  /* The bulb's rays only show when the bulb is "on" (dark mode active).
     [data-theme] lives on <html>, outside this component's scope, so the
     selector needs :global. */
  .bulb-rays {
    opacity: 0;
    transition: opacity var(--duration-fast) var(--ease-out);
  }

  :global([data-theme='dark']) .bulb-rays {
    opacity: 1;
  }

  /* In dark mode the bulb glass fills with the accent color: the lamp is lit. */
  :global([data-theme='dark']) .bulb-glass {
    fill: var(--color-accent);
    stroke: var(--color-accent);
  }
</style>

<script>
  // Wires up the theme toggle. Runs on first load AND after every
  // view-transition page swap (astro:page-load), because the swap replaces
  // the nav with a fresh button that needs a fresh listener.
  function setupThemeToggle() {
    const btn = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
    if (!btn) return;

    // Keep the button's label/state honest about the current theme.
    const sync = () => {
      const dark = document.documentElement.dataset.theme === 'dark';
      btn.setAttribute('aria-pressed', String(dark));
      btn.setAttribute('aria-label', dark ? 'Switch to light mode' : 'Switch to dark mode');
    };

    btn.addEventListener('click', () => {
      const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
      localStorage.setItem('theme', next); // remember across visits
      document.documentElement.dataset.theme = next;
      // Keep the browser chrome color in sync (same values as Base.astro).
      const meta = document.querySelector('meta[name="theme-color"]');
      if (meta) meta.setAttribute('content', next === 'dark' ? '#161614' : '#fafaf8');
      sync();
    });

    sync();
  }
  document.addEventListener('astro:page-load', setupThemeToggle);
</script>
