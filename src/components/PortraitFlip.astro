---
/**
 * PortraitFlip — the hero portrait frame flips over to reveal a cartoon
 * avatar version of the same photo.
 *
 * How it's triggered:
 *   - Mouse: hover flips to the avatar (after a short 150ms "intent" delay,
 *     so a pointer just passing over on its way to the buttons doesn't set
 *     off a 3D turn); leaving flips back. Mouse clicks do nothing extra.
 *   - Touch: tap toggles (there is no hover on touch screens).
 *   - Keyboard: Enter/Space toggles, Escape or moving focus away flips back.
 *
 * How it works:
 *   - A <button> wraps two faces (front = the real headshot, slotted in;
 *     back = the avatar picture). The inner span rotates 180deg in 3D.
 *   - The button starts DISABLED. It is armed only once the hero's intro
 *     choreography has finished — i.e. when the portrait's breathing loop
 *     starts. The script listens for the 'hero-breathe' animationstart event
 *     on .hero-portrait, so the timing can never drift from the CSS.
 *     (Reduced-motion visitors have no intro to wait for, so the button is
 *     armed immediately; their flip is an instant swap with no 3D animation.)
 *   - Without JS the button simply stays disabled and the headshot shows
 *     as normal — the avatar is an enhancement, not content.
 *   - Telemetry: the site's beacon only sees clicks, so the first hover flip
 *     per page view is reported with a 'telemetry:widget' event.
 *
 * The avatar images (avatar-600/1200) are produced by
 * scripts/prepare-avatar.mjs: same 4:5 crop, monochrome, white background —
 * a like-for-like stand-in for the headshot.
 */
---

<div class="portrait-flip" data-portrait-flip>
  <!-- perspective lives on the button (the rotating element's parent) so the
       flip gets real 3D depth. -->
  <button
    class="portrait-flip-button"
    type="button"
    data-flip-button
    data-hover-driven
    aria-label="Show the cartoon avatar portrait"
    disabled
  >
    <span class="portrait-flip-inner">
      <span class="portrait-face portrait-face--front" data-flip-front aria-hidden="false">
        <slot />
      </span>
      <span class="portrait-face portrait-face--back" data-flip-back aria-hidden="true">
        <picture>
          <source
            type="image/avif"
            srcset="/images/avatar-600.avif 600w, /images/avatar-1200.avif 1200w"
            sizes="(min-width: 768px) 32vw, 70vw"
          />
          <source
            type="image/webp"
            srcset="/images/avatar-600.webp 600w, /images/avatar-1200.webp 1200w"
            sizes="(min-width: 768px) 32vw, 70vw"
          />
          <img
            src="/images/avatar-600.jpg"
            srcset="/images/avatar-600.jpg 600w, /images/avatar-1200.jpg 1200w"
            sizes="(min-width: 768px) 32vw, 70vw"
            width="600"
            height="750"
            alt="Cartoon avatar portrait of Jahanzeb Naeem"
            loading="lazy"
            decoding="async"
          />
        </picture>
      </span>
    </span>
  </button>
</div>

<style>
  .portrait-flip-button {
    /* Button reset: make it look exactly like the plain picture it wraps. */
    appearance: none;
    background: none;
    border: none;
    padding: 0;
    margin: 0;
    display: block;
    width: 100%;
    font: inherit;
    color: inherit;
    /* Hover drives the flip for mouse users, so the frame never pretends to
       be a click target. */
    cursor: default;
    /* The 3D depth for the flip. */
    perspective: 1400px;
  }

  .portrait-flip-inner {
    display: block;
    position: relative;
    transform-style: preserve-3d;
    /* Quicker than a one-off click flip: hover can fire it often. */
    transition: transform 0.5s var(--ease-out);
  }

  .portrait-face {
    display: block;
    /* Hide whichever face is pointing away, so the mirrored back of the
       front photo never shows through. */
    backface-visibility: hidden;
  }

  .portrait-face--back {
    /* Stacked exactly over the front face (which defines the frame size),
       pre-rotated so it reads correctly once the inner span turns. */
    position: absolute;
    inset: 0;
    transform: rotateY(180deg);
  }

  .portrait-face--back picture,
  .portrait-face--back img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover; /* safety only — the crop is already exactly 4:5 */
    border-radius: var(--radius-sm); /* match the headshot's inner radius */
  }

  .portrait-flip.is-flipped .portrait-flip-inner {
    transform: rotateY(180deg);
  }

  @media (prefers-reduced-motion: reduce) {
    /* Reduced motion: the faces swap instantly, no 3D turn. */
    .portrait-flip-inner {
      transition: none;
    }
  }
</style>

<script>
  const LABEL_TO_AVATAR = 'Show the cartoon avatar portrait';
  const LABEL_TO_PHOTO = 'Show the real portrait photo';
  // Hover-intent delay: the pointer must rest on the frame this long before
  // it flips, so a pointer just passing over doesn't trigger a 3D turn.
  const HOVER_INTENT_MS = 150;

  function setupPortraitFlip() {
    const root = document.querySelector<HTMLElement>('[data-portrait-flip]');
    if (!root) return; // not on the homepage

    const btn = root.querySelector<HTMLButtonElement>('[data-flip-button]');
    const front = root.querySelector<HTMLElement>('[data-flip-front]');
    const back = root.querySelector<HTMLElement>('[data-flip-back]');
    if (!btn || !front || !back) return;

    let armed = false;
    const arm = () => {
      if (armed) return;
      armed = true;
      btn.disabled = false;
      btn.classList.add('is-armed');
    };

    let fallback = 0;
    const portrait = root.closest('.hero-portrait');
    const onAnimStart = (e: AnimationEvent) => {
      // The breathing loop is the LAST thing to start in the hero's intro
      // choreography, so it doubles as the "intro is over" signal. A paused
      // animation only fires animationstart when it truly begins playing,
      // so a hidden tab can't arm the button early.
      if (e.animationName === 'hero-breathe') arm();
    };

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      arm(); // no intro sequence to wait for
    } else {
      portrait?.addEventListener('animationstart', onAnimStart);
      // Safety net: never leave the button dead if the event is missed.
      fallback = window.setTimeout(arm, 9000);
    }

    let reportedHover = false;
    const setFlipped = (flipped: boolean) => {
      if (root.classList.contains('is-flipped') === flipped) return;
      root.classList.toggle('is-flipped', flipped);
      btn.setAttribute('aria-label', flipped ? LABEL_TO_PHOTO : LABEL_TO_AVATAR);
      front.setAttribute('aria-hidden', String(flipped));
      back.setAttribute('aria-hidden', String(!flipped));
    };

    // Mouse: hover (with intent delay) flips to the avatar; leaving flips back.
    let intent = 0;
    btn.addEventListener('pointerenter', (e) => {
      if (!armed || e.pointerType !== 'mouse') return;
      window.clearTimeout(intent);
      intent = window.setTimeout(() => {
        setFlipped(true);
        if (!reportedHover) {
          reportedHover = true;
          document.dispatchEvent(new CustomEvent('telemetry:widget', { detail: `${LABEL_TO_AVATAR} (hover)` }));
        }
      }, HOVER_INTENT_MS);
    });
    btn.addEventListener('pointerleave', (e) => {
      if (e.pointerType !== 'mouse') return;
      window.clearTimeout(intent);
      setFlipped(false);
    });

    // Touch taps and keyboard (Enter/Space) toggle. A mouse click is ignored:
    // hover already drives the flip, and toggling under the pointer would
    // fight it.
    let lastPointer = '';
    btn.addEventListener('pointerdown', (e) => { lastPointer = e.pointerType; });
    btn.addEventListener('click', (e) => {
      const fromKeyboard = e.detail === 0;
      if (!fromKeyboard && lastPointer === 'mouse') return;
      setFlipped(!root.classList.contains('is-flipped'));
    });
    btn.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') setFlipped(false);
    });
    btn.addEventListener('blur', () => {
      if (!btn.matches(':hover')) setFlipped(false);
    });

    // View-transition cleanup: drop the timers and the animation listener so
    // nothing keeps watching a page that is gone. (The button's own listeners
    // die with the button itself.)
    document.addEventListener('astro:before-swap', () => {
      window.clearTimeout(fallback);
      window.clearTimeout(intent);
      portrait?.removeEventListener('animationstart', onAnimStart);
    }, { once: true });
  }

  // astro:page-load fires on first load AND after every view-transition
  // navigation, so returning to the homepage re-arms the flip.
  document.addEventListener('astro:page-load', setupPortraitFlip);
</script>
