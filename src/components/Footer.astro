---
/**
 * Footer — global contact access (strategy §R: "email/LinkedIn/GitHub always
 * visible in footer"). Present on every page, quiet in style.
 */

import { EMAIL, EMAIL_URL, LINKEDIN_URL, GITHUB_URL } from '../site.config';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-inner">
    <p class="footer-note">© {year} Jahanzeb Naeem · Islamabad, Pakistan</p>

    <ul class="footer-links">
      <li><a class="footer-email" href={EMAIL_URL}>{EMAIL}</a></li>
      <li><a href={LINKEDIN_URL} rel="me noopener noreferrer" target="_blank">LinkedIn</a></li>
      <li><a href={GITHUB_URL} rel="me noopener noreferrer" target="_blank">GitHub</a></li>
    </ul>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-border);
    margin-top: var(--space-24);
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: var(--space-8);
  }

  .footer-note {
    font-size: var(--text-sm);
    color: var(--color-ink-muted);
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap; /* wrap to a second line on small screens */
    gap: var(--space-2) var(--space-6);
    list-style: none;
    padding: 0;
    font-size: var(--text-sm);
  }

  /* The email link may wrap on very narrow screens instead of overflowing. */
  .footer-email {
    overflow-wrap: anywhere;
  }
</style>
